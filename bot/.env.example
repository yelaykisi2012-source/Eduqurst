# ============================================================
# EduQuest Bot — environment variables
# Copy this file to ".env" and fill in YOUR real values:
#   cp .env.example .env        (Git Bash / Linux / macOS)
#   copy .env.example .env      (Windows CMD)
# The .env file is listed in .gitignore and must NEVER be
# committed or shared.
# ============================================================

# 1) Bot token from @BotFather (Telegram) — looks like "123456:ABC-DEF..."
BOT_TOKEN=

# 2) HTTPS URL of your deployed Mini App (set by @BotFather as the
#    Web App URL too). Example: https://eduquest.yourname.workers.dev
#    For local testing use a tunnel URL (ngrok / cloudflared).
MINI_APP_URL=

# 3) Comma-separated Telegram user IDs allowed to use /admin later.
#    Find yours by sending /id style messages to @userinfobot.
ADMIN_USER_IDS=

# 4) Backend API base URL for /start personalisation (public, not secret).
#    Example: https://eduqurst.onrender.com
API_URL=

# 5) Optional: how often the bot pings the backend (seconds, default 300).
#    Inside the Render container this ping is also what keeps the free service
#    — and the bot running in it — from being spun down after 15 idle minutes.
# KEEPALIVE_SECONDS=300

# 6) Optional: throw away messages that arrived while the bot was offline.
#    Good on a laptop (an old queue would fire at you on every restart), bad on
#    a server (pupils' questions would be silently deleted). Default: false.
# DROP_PENDING_UPDATES=true
