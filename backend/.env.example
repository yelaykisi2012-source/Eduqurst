# ============================================================
# EduQuest backend — copy to .env and fill real values.
# NEVER commit .env (already in .gitignore).
# ============================================================

# Neon PostgreSQL connection string.
# In Neon dashboard: your project → Connection string (pooled).
# It must start with postgresql+psycopg://  (SQLAlchemy driver prefix)
# Example: postgresql+psycopg://user:pass@ep-x-y.pooler.neon.tech/eduquest?sslmode=require
DATABASE_URL=

# DIRECT (non-pooled) Neon URL — used ONLY by Alembic for schema migrations,
# because PgBouncer pooling can break DDL. Leave empty to fall back to
# DATABASE_URL. In Neon: Connection string (direct).
DATABASE_URL_UNPOOLED=

# Same bot token as in bot/.env — needed to verify Telegram Mini App
# initData signatures (HMAC). Never expose it to the frontend.
BOT_TOKEN=

# Random secret for signing login tokens (JWT). Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated allowed origins for CORS (the Mini App URLs).
CORS_ORIGINS=http://localhost:5173,https://eduquest-wte5pqe8k86.qoder.website

# Telegram user ids allowed to moderate everything (comma-separated).
# Find your own id by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=

# ---- community chat (rooms, media, moderation) ----
# True  = every pupil message waits in the admin approval queue.
# False = it appears at once and staff delete what is wrong (the default).
# Flipped in Render without touching the code.
CHAT_PREMODERATION=false
# Anti-flood: this many messages per window, counted in the database.
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60

# Secret the school hands to its teachers. Typing it once in the Mini App
# ("Men o‘qituvchiman") opens the teachers' room. Make it 8 characters or
# longer — shorter values are refused by the server on purpose, so the
# teachers' room stays shut even if this is set to something weak.
TEACHER_CODE=

# Size caps for files a pupil attaches in a chat, in bytes.
# Pictures/GIFs are stored in the database; a video is relayed through
# Telegram, so only its file_id is stored.
CHAT_IMAGE_MAX_BYTES=2097152
CHAT_VIDEO_MAX_BYTES=10485760
CHAT_MEDIA_PER_DAY=30
