# ============================================================
# EduQuest backend — copy to .env and fill real values.
# NEVER commit .env (already in .gitignore).
# ============================================================

# Neon PostgreSQL connection string.
# In Neon dashboard: your project → Connection string (pooled).
# It must start with postgresql+psycopg://  (SQLAlchemy driver prefix)
# Example: postgresql+psycopg://user:pass@ep-x-y.pooler.neon.tech/eduquest?sslmode=require
DATABASE_URL=

# DIRECT (non-pooled) Neon URL — used ONLY by Alembic for schema migrations,
# because PgBouncer pooling can break DDL. Leave empty to fall back to
# DATABASE_URL. In Neon: Connection string (direct).
DATABASE_URL_UNPOOLED=

# Same bot token as in bot/.env — needed to verify Telegram Mini App
# initData signatures (HMAC). Never expose it to the frontend.
BOT_TOKEN=

# Random secret for signing login tokens (JWT). Generate e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Comma-separated allowed origins for CORS (the Mini App URLs).
CORS_ORIGINS=http://localhost:5173,https://eduquest-wte5pqe8k86.qoder.website
